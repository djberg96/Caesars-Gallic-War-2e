<% content_for :title, "Caesar's Gallic War" %>

<script type="application/json" id="game-data">
  <%= raw JSON.pretty_generate(@game_data) %>
</script>

<header class="topbar">
  <div>
    <h1>Caesar's Gallic War</h1>
    <p>Second edition prototype</p>
  </div>
  <div class="status-strip" aria-live="polite">
    <span id="mode-label">Solitaire</span>
    <span id="turn-label">58 BC</span>
    <span id="phase-label">Card Phase</span>
    <span id="active-label">Roman</span>
    <span id="supply-label">Supply 15</span>
    <span id="vp-label">VP 0</span>
  </div>
</header>

<main class="shell">
  <section class="board-panel" aria-label="Game board">
    <div class="board-toolbar">
      <button id="new-game" type="button">New</button>
      <button id="deal-cards" type="button">Deal</button>
      <button id="end-turn" type="button">End Turn</button>
      <button id="finish-regroup" type="button" hidden>Finished Regroup</button>
      <button id="undo-move" type="button">Undo</button>
      <button id="toggle-pieces" type="button" aria-pressed="false">Hide</button>
      <button id="save-game" type="button">Save</button>
      <button id="load-game" type="button">Load</button>
      <button id="export-game" type="button">Export</button>
      <label class="select-label" for="play-mode">Mode</label>
      <select id="play-mode">
        <option value="hotseat">Hotseat</option>
        <option value="solitaire" selected>Solitaire Roman</option>
        <option value="ai">AI Opponent</option>
      </select>
    </div>

    <div id="board" class="board">
      <img src="<%= @game_data[:map] %>" alt="Caesar's Gallic War map">
      <svg id="area-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
      <div id="piece-layer" class="piece-layer"></div>
      <div id="neutral-activation-layer" class="neutral-activation-layer" aria-label="Neutral tribe activation cards"></div>
    </div>
  </section>

  <aside class="side-panel">
    <section class="panel-block">
      <h2>Action</h2>
      <div class="segmented" role="group" aria-label="Current player">
        <button type="button" data-player="roman" class="player-button is-active">Roman</button>
        <button type="button" data-player="barbarian" class="player-button">Barbarian</button>
      </div>
      <div id="selected-card" class="selected-card">No card selected.</div>
      <div id="mode-help" class="mode-help"></div>
      <div class="planning-grid">
        <button type="button" id="commit-card">Commit Face Down</button>
        <button type="button" id="reveal-cards">Reveal Cards</button>
        <button type="button" id="bot-card">Bot Card</button>
      </div>
      <div id="committed-cards" class="committed-cards"></div>
      <div class="action-grid">
        <button type="button" data-action="supply">Supply</button>
        <button type="button" data-action="activate">Neutral Tribe</button>
        <button type="button" data-action="political">Political</button>
        <button type="button" data-action="movement">Movement</button>
        <button type="button" data-action="event">Event</button>
        <button type="button" id="resolve-battles">Battles</button>
      </div>
    </section>

    <section class="panel-block">
      <h2>Selection</h2>
      <div id="selection" class="selection">Select a unit or area.</div>
      <div id="area-detail" class="area-detail"></div>
    </section>

    <section class="panel-block">
      <h2>Log</h2>
      <ol id="log" class="log"></ol>
    </section>
  </aside>

  <section id="hand-tray" class="hand-tray" aria-label="Player hands">
    <div class="hand-tray-header">
      <strong>Cards</strong>
      <button type="button" id="toggle-hand" aria-expanded="true">Hide Hand</button>
    </div>
    <div class="hands">
      <div class="hand-zone">
        <h3>Roman Hand</h3>
        <div id="roman-hand" class="hand"></div>
      </div>
      <div class="hand-zone">
        <h3>Barbarian Hand</h3>
        <div id="barbarian-hand" class="hand"></div>
      </div>
    </div>
  </section>
  <div id="card-zoom" class="card-zoom" hidden></div>
</main>

<dialog id="export-dialog">
  <form method="dialog">
    <h2>Export Save</h2>
    <textarea id="export-text" spellcheck="false"></textarea>
    <div class="dialog-actions">
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>

<dialog id="battle-dialog" class="battle-dialog">
  <h2>Battle Board</h2>
  <div id="battle-summary" class="battle-summary"></div>
  <div id="battle-zones" class="battle-zones"></div>
  <div id="battle-actions" class="battle-actions"></div>
</dialog>

<dialog id="main-force-dialog" class="choice-dialog">
  <h2 id="main-force-title">Choose Main Force</h2>
  <p id="main-force-message"></p>
  <div id="main-force-choices" class="choice-list"></div>
  <div class="dialog-actions">
    <button type="button" id="main-force-cancel">Cancel</button>
  </div>
</dialog>

<dialog id="result-dialog">
  <form method="dialog">
    <h2 id="result-title">Result</h2>
    <p id="result-message"></p>
    <div class="dialog-actions">
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>
