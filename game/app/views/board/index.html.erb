<% content_for :title, "Caesar's Gallic War" %>

<script type="application/json" id="game-data">
  <%= raw JSON.pretty_generate(@game_data) %>
</script>

<main class="shell">
  <section class="board-panel" aria-label="Game board">
    <div class="board-toolbar">
      <details id="game-menu" class="toolbar-game-menu">
        <summary>Game</summary>
        <div class="toolbar-game-menu-items" role="group" aria-label="Game file actions">
          <button id="new-game" type="button">New Game</button>
          <button id="export-game" type="button">Save</button>
          <button id="import-game" type="button">Load</button>
        </div>
      </details>
      <button id="end-turn" type="button">End Turn</button>
      <button id="resolve-battles" type="button">Battles</button>
      <button id="finish-regroup" type="button" hidden>Finished Regroup</button>
      <button id="undo-move" type="button">Undo</button>
      <button id="toggle-pieces" type="button" aria-pressed="false">Hide Units</button>
      <label class="select-label" for="map-zoom">Zoom</label>
      <select id="map-zoom" class="map-zoom" aria-label="Map zoom">
        <option value="0.5">50%</option>
        <option value="0.75">75%</option>
        <option value="1" selected>100%</option>
        <option value="1.25">125%</option>
        <option value="1.5">150%</option>
      </select>
      <label id="play-mode-label" class="select-label" for="play-mode">Mode</label>
      <select id="play-mode">
        <option value="hotseat">Hotseat</option>
        <option value="solitaire" selected>Solitaire Roman</option>
        <option value="ai">AI Opponent</option>
      </select>
      <label id="yearly-objectives-toggle" class="optional-rule-toggle" title="Apply the optional Yearly Objectives victory-point schedule">
        <input id="yearly-objectives" type="checkbox">
        Yearly Objectives
      </label>
      <div id="bot-movement-review" class="bot-movement-review" role="status" aria-live="polite" hidden>
        <div class="bot-movement-review-copy">
          <strong>Barbarian Movement</strong>
          <span id="bot-movement-review-routes"></span>
        </div>
        <button id="continue-bot-movement-review" type="button">Continue to Battle</button>
      </div>
      <div id="revolt-target-panel" class="revolt-target-panel" role="status" aria-live="polite" hidden>
        <div class="revolt-target-copy">
          <strong id="revolt-target-title">Revolt</strong>
          <span id="revolt-target-instructions">Choose a highlighted tribe on the map.</span>
        </div>
        <button id="cancel-revolt-target" type="button">Cancel</button>
      </div>
      <div id="retreat-target-panel" class="retreat-target-panel" role="status" aria-live="polite" hidden>
        <div class="retreat-target-copy">
          <strong>Retreat</strong>
          <span id="retreat-target-instructions">Choose a highlighted destination on the map.</span>
        </div>
        <button id="cancel-retreat-target" type="button">Back to Battle</button>
      </div>
    </div>

    <form id="winter-quarters-form" class="winter-quarters-panel" hidden>
      <div class="winter-quarters-heading">
        <span class="dialog-kicker">End of Year</span>
        <strong>Choose Roman Winter Quarters</strong>
      </div>
      <div class="winter-quarters-instructions">
        <p id="winter-quarters-summary"></p>
        <p class="winter-quarters-note">Select highlighted legions directly on the map. Unselected legions return to Transalpine Gaul.</p>
      </div>
      <div class="winter-quarters-status">
        <strong id="winter-quarters-selection">No legions selected</strong>
        <p id="winter-quarters-error" class="import-error" role="alert" hidden></p>
      </div>
      <button type="submit" class="winter-quarters-continue">Continue End Turn</button>
    </form>

    <div id="board" class="board">
      <div id="board-stage" class="board-stage">
        <div id="board-canvas" class="board-canvas">
          <img src="<%= @game_data[:map] %>" alt="Caesar's Gallic War map">
          <svg id="area-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
          <svg id="movement-arrow-layer" class="movement-arrow-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Battle entry arrows"></svg>
          <div id="track-marker-layer" class="track-marker-layer" aria-label="Game record markers"></div>
          <div id="piece-layer" class="piece-layer"></div>
          <div id="neutral-activation-layer" class="neutral-activation-layer" aria-label="Neutral tribe activation cards"></div>
        </div>
      </div>
    </div>
  </section>

  <aside id="side-panel" class="side-panel" aria-label="Game information">
    <button type="button" id="toggle-side-panel" class="side-panel-toggle" aria-expanded="true" aria-label="Collapse information panel">›</button>
    <div class="side-panel-content">
      <section class="panel-block command-panel">
        <header class="game-brand">
          <span>Second Edition</span>
          <h1>Caesar's Gallic War</h1>
        </header>

        <div class="campaign-status" aria-live="polite">
          <div><span>Mode</span><strong id="mode-label">Solitaire</strong></div>
          <div><span>Year</span><strong id="turn-label">58 BC</strong></div>
          <div><span>Phase</span><strong id="phase-label">Card Phase</strong></div>
          <div><span>Active</span><strong id="active-label">Roman</strong></div>
          <div><span>Supply</span><strong id="supply-label">15</strong></div>
          <div><span>Roman VP</span><strong id="vp-label">0</strong></div>
        </div>
      </section>

      <section id="yearly-objectives-panel" class="panel-block objective-panel" hidden>
        <div class="objective-panel-heading">
          <div>
            <span class="objective-kicker">Optional Rule</span>
            <h2 id="objective-title">Yearly Objectives</h2>
          </div>
          <strong id="objective-year"></strong>
        </div>
        <ul id="objective-list" class="objective-list"></ul>
      </section>

      <section class="panel-block">
        <h2>Selection</h2>
        <div id="selection" class="selection">Select a unit or area.</div>
        <div id="area-detail" class="area-detail"></div>
      </section>

      <section class="panel-block">
        <h2>Log</h2>
        <ol id="log" class="log"></ol>
      </section>
    </div>
  </aside>

  <section id="hand-tray" class="hand-tray" aria-label="Player hands">
    <div class="hand-tray-header">
      <strong id="hand-tray-title">Cards</strong>
      <div id="hotseat-controls" class="hotseat-controls" hidden>
        <div class="segmented" role="group" aria-label="Current player">
          <button type="button" data-player="roman" class="player-button is-active">Roman</button>
          <button type="button" data-player="barbarian" class="player-button">Barbarian</button>
        </div>
        <button type="button" id="commit-card">Commit</button>
        <button type="button" id="reveal-cards">Reveal</button>
        <div id="committed-cards" class="committed-cards"></div>
      </div>
      <button type="button" id="toggle-hand" aria-expanded="true">Hide Hand</button>
    </div>
    <div class="hands">
      <div class="hand-zone">
        <h3>Roman Hand</h3>
        <div id="roman-hand" class="hand"></div>
      </div>
      <div class="hand-zone">
        <h3>Barbarian Hand</h3>
        <div id="barbarian-hand" class="hand"></div>
      </div>
    </div>
  </section>
  <div id="card-zoom" class="card-zoom" hidden></div>
</main>

<dialog id="export-dialog">
  <form method="dialog">
    <h2>Save Game</h2>
    <p class="dialog-description">Save this game as a JSON file. The text below contains the same save data.</p>
    <textarea id="export-text" spellcheck="false" readonly></textarea>
    <div class="dialog-actions">
      <button id="download-export" type="button">Save JSON File</button>
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>

<dialog id="import-dialog">
  <form id="import-form">
    <h2>Load Game</h2>
    <p class="dialog-description">Choose a saved JSON file, or paste saved game data below.</p>
    <label class="import-file-label" for="import-file">Choose JSON file</label>
    <input id="import-file" type="file" accept="application/json,.json">
    <textarea id="import-text" spellcheck="false" placeholder="Paste exported game JSON here"></textarea>
    <p id="import-error" class="import-error" role="alert" hidden></p>
    <div class="dialog-actions">
      <button id="cancel-import" type="button">Cancel</button>
      <button type="submit">Load Game</button>
    </div>
  </form>
</dialog>

<dialog id="new-game-dialog" class="new-game-dialog">
  <h2>Start a New Game?</h2>
  <p class="dialog-description">A game is already in progress. Would you like to save it before starting over?</p>
  <div class="dialog-actions new-game-actions">
    <button id="cancel-new-game" type="button">Cancel</button>
    <button id="discard-new-game" type="button">Start Without Saving</button>
    <button id="save-new-game" type="button">Save &amp; Start New</button>
  </div>
</dialog>

<dialog id="turn-dialog" class="turn-dialog">
  <form id="turn-dialog-form" method="dialog">
    <h2 id="turn-dialog-title">Turn 1 (58BC)</h2>
    <p class="turn-dialog-message">New hand of cards dealt.</p>
    <div id="turn-dialog-status" class="turn-dialog-status" hidden>
      <span>Roman VP <strong id="turn-dialog-vp">0</strong></span>
      <span>Supply <strong id="turn-dialog-supply">15</strong></span>
    </div>
    <div class="dialog-actions">
      <button id="acknowledge-turn" type="submit">OK</button>
    </div>
  </form>
</dialog>

<dialog id="bot-action-review-dialog" class="bot-action-review-dialog">
  <div class="bot-action-review-layout">
    <img id="bot-action-review-card" class="bot-action-review-card" alt="">
    <section class="bot-action-review-copy">
      <span id="bot-action-review-kicker" class="dialog-kicker">Barbarian Action</span>
      <h2 id="bot-action-review-title"></h2>
      <p id="bot-action-review-message"></p>
      <ul id="bot-action-review-details" class="bot-action-review-details"></ul>
      <div class="dialog-actions">
        <button id="advance-bot-action-review" type="button">Continue</button>
      </div>
    </section>
  </div>
</dialog>

<dialog id="battle-transition-dialog" class="turn-dialog battle-transition-dialog" aria-labelledby="battle-transition-title">
  <form id="battle-transition-form">
    <span class="dialog-kicker">Battle Complete</span>
    <h2 id="battle-transition-title">Next Battle</h2>
    <p id="battle-transition-message" class="turn-dialog-message"></p>
    <div class="dialog-actions">
      <button id="continue-next-battle" type="submit">Continue to Battle</button>
    </div>
  </form>
</dialog>

<dialog id="roman-administration-dialog" class="roman-administration-dialog" aria-labelledby="roman-administration-title">
  <form id="roman-administration-form" class="roman-administration-modal-form">
    <header class="roman-administration-modal-header">
      <span class="dialog-kicker">End of Year</span>
      <h2 id="roman-administration-title">Roman Administration</h2>
    </header>
    <div id="roman-administration-options" class="roman-administration-options"></div>
    <footer class="roman-administration-footer">
      <div class="winter-quarters-status">
        <strong id="roman-administration-status"></strong>
        <p id="roman-administration-error" class="import-error" role="alert" hidden></p>
      </div>
      <button id="roman-administration-continue" type="submit" class="winter-quarters-continue">Continue</button>
    </footer>
  </form>
</dialog>

<dialog id="battle-dialog" class="battle-dialog">
  <div class="battle-board-title">
    <h2>Battle Board</h2>
    <span id="battle-round-header" class="battle-round"></span>
  </div>
  <div id="battle-roll-toast" class="battle-roll-toast" role="status" aria-live="polite" aria-atomic="true" hidden></div>
  <div id="battle-summary" class="battle-summary"></div>
  <div id="battle-zones" class="battle-zones"></div>
  <div id="battle-details" class="battle-details"></div>
  <div id="battle-actions" class="battle-actions"></div>
</dialog>

<dialog id="main-force-dialog" class="choice-dialog">
  <h2 id="main-force-title">Choose Main Force</h2>
  <p id="main-force-message"></p>
  <div id="main-force-choices" class="choice-list"></div>
  <div class="dialog-actions">
    <button type="button" id="main-force-cancel">Cancel</button>
  </div>
</dialog>

<dialog id="result-dialog">
  <form method="dialog">
    <h2 id="result-title">Result</h2>
    <div id="result-message"></div>
    <div class="dialog-actions">
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>
