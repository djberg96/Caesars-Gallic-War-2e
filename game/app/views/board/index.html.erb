<% content_for :title, "Caesar's Gallic War" %>

<script type="application/json" id="game-data">
  <%= raw JSON.pretty_generate(@game_data) %>
</script>

<main class="shell">
  <section class="board-panel" aria-label="Game board">
    <div class="board-toolbar">
      <button id="new-game" type="button">New</button>
      <button id="end-turn" type="button">End Turn</button>
      <button id="resolve-battles" type="button">Battles</button>
      <button id="finish-regroup" type="button" hidden>Finished Regroup</button>
      <button id="undo-move" type="button">Undo</button>
      <button id="toggle-pieces" type="button" aria-pressed="false">Hide Units</button>
      <button id="export-game" type="button">Save</button>
      <button id="import-game" type="button">Load</button>
      <label class="select-label" for="play-mode">Mode</label>
      <select id="play-mode">
        <option value="hotseat">Hotseat</option>
        <option value="solitaire" selected>Solitaire Roman</option>
        <option value="ai">AI Opponent</option>
      </select>
      <label class="optional-rule-toggle" title="Apply the optional Yearly Objectives victory-point schedule">
        <input id="yearly-objectives" type="checkbox">
        Yearly Objectives
      </label>
    </div>

    <div id="board" class="board">
      <img src="<%= @game_data[:map] %>" alt="Caesar's Gallic War map">
      <svg id="area-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"></svg>
      <div id="track-marker-layer" class="track-marker-layer" aria-label="Game record markers"></div>
      <div id="piece-layer" class="piece-layer"></div>
      <div id="neutral-activation-layer" class="neutral-activation-layer" aria-label="Neutral tribe activation cards"></div>
    </div>
  </section>

  <aside id="side-panel" class="side-panel" aria-label="Game information">
    <button type="button" id="toggle-side-panel" class="side-panel-toggle" aria-expanded="true" aria-label="Collapse information panel">›</button>
    <div class="side-panel-content">
      <section class="panel-block command-panel">
        <header class="game-brand">
          <span>Second Edition</span>
          <h1>Caesar's Gallic War</h1>
        </header>

        <div class="campaign-status" aria-live="polite">
          <div><span>Mode</span><strong id="mode-label">Solitaire</strong></div>
          <div><span>Year</span><strong id="turn-label">58 BC</strong></div>
          <div><span>Phase</span><strong id="phase-label">Card Phase</strong></div>
          <div><span>Active</span><strong id="active-label">Roman</strong></div>
          <div><span>Supply</span><strong id="supply-label">15</strong></div>
          <div><span>Roman VP</span><strong id="vp-label">0</strong></div>
        </div>
      </section>

      <section id="yearly-objectives-panel" class="panel-block objective-panel" hidden>
        <div class="objective-panel-heading">
          <div>
            <span class="objective-kicker">Optional Rule</span>
            <h2 id="objective-title">Yearly Objectives</h2>
          </div>
          <strong id="objective-year"></strong>
        </div>
        <ul id="objective-list" class="objective-list"></ul>
      </section>

      <section class="panel-block">
        <h2>Selection</h2>
        <div id="selection" class="selection">Select a unit or area.</div>
        <div id="area-detail" class="area-detail"></div>
      </section>

      <section class="panel-block">
        <h2>Log</h2>
        <ol id="log" class="log"></ol>
      </section>
    </div>
  </aside>

  <section id="hand-tray" class="hand-tray" aria-label="Player hands">
    <div class="hand-tray-header">
      <strong>Cards</strong>
      <div id="hotseat-controls" class="hotseat-controls" hidden>
        <div class="segmented" role="group" aria-label="Current player">
          <button type="button" data-player="roman" class="player-button is-active">Roman</button>
          <button type="button" data-player="barbarian" class="player-button">Barbarian</button>
        </div>
        <button type="button" id="commit-card">Commit</button>
        <button type="button" id="reveal-cards">Reveal</button>
        <div id="committed-cards" class="committed-cards"></div>
      </div>
      <button type="button" id="toggle-hand" aria-expanded="true">Hide Hand</button>
    </div>
    <div class="hands">
      <div class="hand-zone">
        <h3>Roman Hand</h3>
        <div id="roman-hand" class="hand"></div>
      </div>
      <div class="hand-zone">
        <h3>Barbarian Hand</h3>
        <div id="barbarian-hand" class="hand"></div>
      </div>
    </div>
  </section>
  <div id="card-zoom" class="card-zoom" hidden></div>
</main>

<dialog id="export-dialog">
  <form method="dialog">
    <h2>Save Game</h2>
    <p class="dialog-description">Save this game as a JSON file. The text below contains the same save data.</p>
    <textarea id="export-text" spellcheck="false" readonly></textarea>
    <div class="dialog-actions">
      <button id="download-export" type="button">Save JSON File</button>
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>

<dialog id="import-dialog">
  <form id="import-form">
    <h2>Load Game</h2>
    <p class="dialog-description">Choose a saved JSON file, or paste saved game data below.</p>
    <label class="import-file-label" for="import-file">Choose JSON file</label>
    <input id="import-file" type="file" accept="application/json,.json">
    <textarea id="import-text" spellcheck="false" placeholder="Paste exported game JSON here"></textarea>
    <p id="import-error" class="import-error" role="alert" hidden></p>
    <div class="dialog-actions">
      <button id="cancel-import" type="button">Cancel</button>
      <button type="submit">Load Game</button>
    </div>
  </form>
</dialog>

<dialog id="battle-dialog" class="battle-dialog">
  <h2>Battle Board</h2>
  <div id="battle-summary" class="battle-summary"></div>
  <div id="battle-zones" class="battle-zones"></div>
  <div id="battle-actions" class="battle-actions"></div>
</dialog>

<dialog id="main-force-dialog" class="choice-dialog">
  <h2 id="main-force-title">Choose Main Force</h2>
  <p id="main-force-message"></p>
  <div id="main-force-choices" class="choice-list"></div>
  <div class="dialog-actions">
    <button type="button" id="main-force-cancel">Cancel</button>
  </div>
</dialog>

<dialog id="result-dialog">
  <form method="dialog">
    <h2 id="result-title">Result</h2>
    <p id="result-message"></p>
    <div class="dialog-actions">
      <button type="submit">Close</button>
    </div>
  </form>
</dialog>
